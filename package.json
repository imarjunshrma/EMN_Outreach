{
  "name": "emn-outreach-os",
  "version": "1.4.0",
  "private": true,
  "description": "Outvexa — self-hosted AI outreach and email management platform (Elite Media Networks)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && node --import tsx scripts/apply-sql.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --import tsx prisma/seed.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:frontend": "npm --prefix frontend run build",
    "start:api": "node dist/backend/src/main.js",
    "start:worker": "node dist/worker/src/main.js",
    "dev:api": "tsx watch backend/src/main.ts",
    "dev:worker": "tsx watch worker/src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "openapi": "node --import tsx scripts/generate-openapi.ts",
    "create-admin": "node --import tsx scripts/create-admin.ts",
    "gen-keys": "node scripts/gen-keys.mjs",
    "api-docs": "node --import tsx scripts/generate-api-docs.ts",
    "reset-password": "node --import tsx scripts/reset-password.ts",
    "test:e2e": "bash scripts/e2e.sh",
    "live-check": "node --import tsx scripts/live-check.ts",
    "saas:matrices": "node --import tsx scripts/generate-saas-matrices.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@openai/codex-sdk": "0.171.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "bullmq": "6.7.8",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "express": "5.3.0",
    "imapflow": "2.12.2",
    "ioredis": "6.0.0",
    "luxon": "3.7.2",
    "mailparser": "3.15.0",
    "multer": "2.5.0",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "2.18.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/mailparser": "3.9.0",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "2.16.2",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prisma": "7.10.1",
    "smtp-server": "^3.21.7",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
