// =====================================================================
// EMN Outreach OS — Prisma schema
// PostgreSQL 16 · Prisma 7 (prisma-client generator + @prisma/adapter-pg)
//
// Conventions
//  - UUID primary keys; timestamps are timestamptz written in UTC.
//  - Every customer-owned row carries workspaceId (indexed) and cascades from Workspace.
//  - Secrets are stored only as AES-256-GCM envelopes ("v<key>:<iv>:<tag>:<ct>"), never plaintext.
// =====================================================================

generator client {
  provider     = "prisma-client"
  output       = "../backend/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

