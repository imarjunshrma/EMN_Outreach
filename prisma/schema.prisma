  pausedAt             DateTime?      @db.Timestamptz(3)
  pauseReason          String?
  completedAt          DateTime?      @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)

  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sequence       Sequence?
  lists          CampaignList[]
  accounts       CampaignEmailAccount[]
  enrollments    SequenceEnrollment[]
  outboundEmails OutboundEmail[]
  conversations  Conversation[]
  events         EmailEvent[]
  opportunities  Opportunity[]

  icpId                  String?                @db.Uuid
  aiProfileId            String?                @db.Uuid
  aiOverrides            Json                   @default("{}")
  maxAiCostPerLeadUsd    Decimal?               @db.Decimal(10, 4)
  usePregeneratedAi      Boolean                @default(true)
  aiConfigSnapshot       Json?
  aiSnapshotAt           DateTime?              @db.Timestamptz(3)
  scheduledStartAt       DateTime?              @db.Timestamptz(3)
  icp                    IdealCustomerProfile?  @relation(fields: [icpId], references: [id], onDelete: SetNull)
  aiProfile              PromptProfile?         @relation(fields: [aiProfileId], references: [id], onDelete: SetNull)
  personalizations       LeadPersonalization[]
  personalizationBatches PersonalizationBatch[]
  sequenceVersions       SequenceVersion[]

  folder         String?
  tags           String[]
  aiWorkflowRuns AiWorkflowRun[]

  @@index([workspaceId, status])
}

