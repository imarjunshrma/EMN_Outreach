// ---------------------------------------------------------------- identity

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  name            String
  passwordHash    String
  status          UserStatus @default(ACTIVE)
  isPlatformAdmin Boolean    @default(false)
  lastLoginAt     DateTime?  @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  sessions          Session[]
  memberships       WorkspaceMember[]
  invitesSent       WorkspaceInvitation[] @relation("InvitedBy")
  notifications     Notification[]
  tasksAssigned     Task[]                @relation("TaskAssignee")
  leadsOwned        Lead[]                @relation("LeadOwner")
  notes             Note[]
  auditLogs         AuditLog[]
  mfaEnabled        Boolean               @default(false)
  mfaSecretEnc      String?
  mfaRecoveryHashes String[]
  mfaEnabledAt      DateTime?             @db.Timestamptz(3)
  emailVerifiedAt   DateTime?             @db.Timestamptz(3)
  termsAcceptedAt   DateTime?             @db.Timestamptz(3)
  termsVersion      String?
  platformRole      PlatformRole?
  locale            String?
  orgMemberships    OrganizationMember[]

  // Personal AI subscriptions (owner-only feature)
  aiSubscriptionConnections AiSubscriptionConnection[]
  aiWorkflows               AiWorkflow[]
  aiStageTemplates          AiStageTemplate[]
  aiPlaybookVersions        AiPlaybookVersion[]
  aiWorkflowRuns            AiWorkflowRun[]
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  tokenHash         String    @unique
  csrfToken         String
  userId            String    @db.Uuid
  activeWorkspaceId String?   @db.Uuid
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)
  // "Log in as": set when a super admin opened this session on the user's behalf (time-limited, audited, never extended).
  impersonatorId      String?   @db.Uuid
  impersonationReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([impersonatorId])
}

model Workspace {
  id              String    @id @default(uuid()) @db.Uuid
  // Owning tenant. Every workspace-scoped record inherits its tenant through this column; it can never change (DB trigger).
  organizationId  String    @db.Uuid
  name            String
  slug            String    @unique
  branding        Json      @default("{}")
  archivedAt      DateTime? @db.Timestamptz(3)
  timezone        String    @default("UTC")
  // Sender identity & compliance footer
  senderLegalName String?
  postalAddress   String?
  // Free-form settings validated by WorkspaceSettingsSchema (booking link, retention days, tracking, offer facts…)
  settings        Json      @default("{}")
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  members                     WorkspaceMember[]
  invitations                 WorkspaceInvitation[]
  apiKeys                     ApiKey[]
  domains                     Domain[]
  domainChecks                DomainHealthCheck[]
  emailAccounts               EmailAccount[]
  credentials                 ProviderCredential[]
  aiProviders                 AiProvider[]
  aiRoutes                    AiModelRoute[]
  prompts                     PromptTemplate[]
  aiExecutions                AiExecution[]
  integrations                Integration[]
  usageRecords                UsageRecord[]
  companies                   Company[]
  leadSources                 LeadSource[]
  leads                       Lead[]
  statusChanges               LeadStatusChange[]
  verifications               EmailVerification[]
  verificationBatches         EmailVerificationBatch[]
  verificationDomainOverrides EmailVerificationDomainOverride[]
  verificationRolePatterns    EmailVerificationRolePattern[]
  icps                        IdealCustomerProfile[]
  researchReports             ResearchReport[]
  researchEvidence            ResearchEvidence[]
  researchClaims              ResearchClaim[]
  leadScores                  LeadScore[]
  leadLists                   LeadList[]
  leadListMembers             LeadListMember[]
  importJobs                  ImportJob[]
  prospectSearches            ProspectSearch[]
  templates                   Template[]
  campaigns                   Campaign[]
  sequences                   Sequence[]
  sequenceSteps               SequenceStep[]
  stepVariants                SequenceStepVariant[]
  campaignLists               CampaignList[]
  campaignAccounts            CampaignEmailAccount[]
  enrollments                 SequenceEnrollment[]
  outboundEmails              OutboundEmail[]
  trackedLinks                TrackedLink[]
  conversations               Conversation[]
  messages                    EmailMessage[]
  attachments                 EmailAttachment[]
  events                      EmailEvent[]
  suppressions                SuppressionEntry[]
  complianceRules             ComplianceRule[]
  privacyRequests             PrivacyRequest[]
  opportunities               Opportunity[]
  notes                       Note[]
  tasks                       Task[]
  automations                 AutomationRule[]
  automationRuns              AutomationRun[]
  webhooks                    Webhook[]
  webhookDeliveries           WebhookDelivery[]
  notifications               Notification[]
  auditLogs                   AuditLog[]
  jobRuns                     JobRun[]
  errorLogs                   ErrorLog[]
  aiConfigVersions            AiConfigVersion[]
  knowledgeDocuments          KnowledgeDocument[]
  promptProfiles              PromptProfile[]
  promptProfileVersions       PromptProfileVersion[]
  personalizations            LeadPersonalization[]
  personalizationRevisions    PersonalizationRevision[]
  personalizationBatches      PersonalizationBatch[]
  sequenceVersions            SequenceVersion[]
  passwordResets              PasswordResetToken[]
  replyTemplates              ReplyTemplate[]
  replySuggestions            ReplySuggestion[]
  copilotThreads              CopilotThread[]
  copilotMessages             CopilotMessage[]
  copilotActions              CopilotAction[]
  copilotMemories             CopilotMemory[]
  workflows                   Workflow[]
  workflowVersions            WorkflowVersion[]
  workflowRuns                WorkflowRun[]
  subscription                Subscription?
  invoices                    Invoice[]
  savedFilters                SavedFilter[]
  scheduledReports            ScheduledReport[]
  notificationChannels        NotificationChannel[]
  usageEvents                 UsageEvent[]
  outreachRules               OutreachRule[]
  outreachExamples            OutreachExample[]
  outreachFeedback            OutreachFeedback[]
  aiLearningSuggestions       AiLearningSuggestion[]

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiWorkflowRuns AiWorkflowRun[]

  @@index([organizationId])
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique
  invitedById String        @db.Uuid
  expiresAt   DateTime      @db.Timestamptz(3)
  acceptedAt  DateTime?     @db.Timestamptz(3)
  revokedAt   DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
}

// Programmatic API access (header: Authorization: Bearer emn_<prefix>_<secret>)
model ApiKey {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  name        String
  prefix      String        @unique
  keyHash     String
  role        WorkspaceRole @default(MEMBER)
  lastUsedAt  DateTime?     @db.Timestamptz(3)
  expiresAt   DateTime?     @db.Timestamptz(3)
  revokedAt   DateTime?     @db.Timestamptz(3)
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  scopes String[]

  @@index([workspaceId])
}

// ---------------------------------------------------------------- domains & mailboxes

model Domain {
  id            String         @id @default(uuid()) @db.Uuid
  workspaceId   String         @db.Uuid
  name          String
  healthStatus  HealthStatus   @default(UNKNOWN)
  spfStatus     DnsCheckStatus @default(UNKNOWN)
  dkimStatus    DnsCheckStatus @default(UNKNOWN)
  dmarcStatus   DnsCheckStatus @default(UNKNOWN)
  mxStatus      DnsCheckStatus @default(UNKNOWN)
  dkimSelectors String[]       @default(["google", "selector1", "selector2", "default"])
  lastCheckedAt DateTime?      @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checks        DomainHealthCheck[]
  emailAccounts EmailAccount[]

  verificationToken String?
  verifiedAt        DateTime? @db.Timestamptz(3)
  registrar         String?
  expiresAt         DateTime? @db.Timestamptz(3)
  autoRenew         Boolean?
  dnsProvider       String?
  dnsZoneId         String?
  propagation       Json?
  renewalNotifiedAt DateTime? @db.Timestamptz(3)

  @@unique([workspaceId, name])
}

model DomainHealthCheck {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid
  domainId    String         @db.Uuid
  spfStatus   DnsCheckStatus
  spfRecord   String?
  dkimStatus  DnsCheckStatus
  dkimResults Json
  dmarcStatus DnsCheckStatus
  dmarcRecord String?
  mxStatus    DnsCheckStatus
  mxRecords   Json
  issues      Json           @default("[]")
  checkedAt   DateTime       @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domain    Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, checkedAt])
  @@index([workspaceId])
}

model EmailAccount {
  id                     String             @id @default(uuid()) @db.Uuid
  workspaceId            String             @db.Uuid
  domainId               String?            @db.Uuid
  provider               EmailProviderType
  emailAddress           String
  displayName            String?
  replyTo                String?
  providerAccountId      String?
  status                 EmailAccountStatus @default(CONNECTED)
  statusReason           String?
  dailySendLimit         Int                @default(25)
  minSecondsBetweenSends Int                @default(180)
  sendingWindow          Json // {days:[1..7], start:"09:00", end:"17:00", timezone:"Asia/Kolkata"}
  signatureText          String?
  connectionConfig       Json               @default("{}") // SMTP/IMAP host/port/user (non-secret)
  syncCursor             String?
  watchExpiresAt         DateTime?          @db.Timestamptz(3)
  subscriptionId         String?
  subscriptionSecretHash String?
  lastSyncedAt           DateTime?          @db.Timestamptz(3)
  lastSentAt             DateTime?          @db.Timestamptz(3)
  lastErrorAt            DateTime?          @db.Timestamptz(3)
  lastError              String?
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domain           Domain?                @relation(fields: [domainId], references: [id], onDelete: SetNull)
  credential       ProviderCredential?
  campaignAccounts CampaignEmailAccount[]
  enrollments      SequenceEnrollment[]
  outboundEmails   OutboundEmail[]
  conversations    Conversation[]
  messages         EmailMessage[]
  events           EmailEvent[]

  lastReceivedAt DateTime? @db.Timestamptz(3)

  @@unique([workspaceId, emailAddress])
  @@index([subscriptionId])
}

model ProviderCredential {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceId           String    @db.Uuid
  emailAccountId        String    @unique @db.Uuid
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  encryptedPassword     String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  scopes                String[]
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ---------------------------------------------------------------- AI

model AiProvider {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @db.Uuid
  provider        AiProviderType
  encryptedApiKey String
  keyLast4        String
  isEnabled       Boolean        @default(true)
  defaultModel    String
  baseUrl         String?
  lastTestedAt    DateTime?      @db.Timestamptz(3)
  lastTestOk      Boolean?
  lastTestError   String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

model AiModelRoute {
  id               String          @id @default(uuid()) @db.Uuid
  workspaceId      String          @db.Uuid
  task             AiTask
  provider         AiProviderType
  model            String
  useWorkspaceDefault Boolean       @default(false)
  fallbackProvider AiProviderType?
  fallbackModel    String?
  temperature      Float?
  maxOutputTokens  Int             @default(1500)
  monthlyBudgetUsd Decimal?        @db.Decimal(10, 2)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  maxInputTokens Int?

  @@unique([workspaceId, task])
}

// Global price table (USD per million tokens). Editable from AI settings by platform admins.
model AiModelPrice {
  id                    String         @id @default(uuid()) @db.Uuid
  provider              AiProviderType
  model                 String
  inputPerMTokUsd       Decimal        @db.Decimal(12, 6)
  outputPerMTokUsd      Decimal        @db.Decimal(12, 6)
  cachedInputPerMTokUsd Decimal?       @db.Decimal(12, 6)
  effectiveFrom         DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([provider, model, effectiveFrom])
}

model PromptTemplate {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @db.Uuid
  task               AiTask
  version            Int
  systemPrompt       String
  userPromptTemplate String
  isActive           Boolean  @default(false)
  changeNote         String?
  createdById        String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions AiExecution[]

  @@unique([workspaceId, task, version])
}

model AiExecution {
  id               String            @id @default(uuid()) @db.Uuid
  workspaceId      String            @db.Uuid
  task             AiTask
  provider         AiProviderType
  model            String
  promptTemplateId String?           @db.Uuid
  status           AiExecutionStatus
  usedFallback     Boolean           @default(false)
  generationMode   String?
  inputTokens      Int               @default(0)
  outputTokens     Int               @default(0)
  cachedTokens     Int               @default(0)
  costUsd          Decimal           @default(0) @db.Decimal(12, 6)
  costIsEstimate   Boolean           @default(true)
  latencyMs        Int?
  errorMessage     String?
  entityType       String?
  entityId         String?
  inputPreview     String?
  output           Json?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  promptTemplate PromptTemplate? @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)

  campaignId       String? @db.Uuid
  leadId           String? @db.Uuid
  profileVersionId String? @db.Uuid

  @@index([workspaceId, createdAt])
  @@index([workspaceId, task, createdAt])
  @@index([entityType, entityId])
  @@index([workspaceId, campaignId, leadId])
}

// Third-party provider credentials: apollo, millionverifier, brave, serper, smartlead, booking
model Integration {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  type            String
  encryptedConfig String?
  publicConfig    Json      @default("{}")
  isEnabled       Boolean   @default(true)
  lastTestedAt    DateTime? @db.Timestamptz(3)
  lastTestOk      Boolean?
  lastError       String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type])
}

model UsageRecord {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  provider    String // apollo | millionverifier | brave | serper | gmail | microsoft ...
  kind        String // search | enrich | verify | web_search | send
  units       Int      @default(1)
  costUsd     Decimal? @db.Decimal(12, 6)
  isEstimate  Boolean  @default(true)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, provider, createdAt])
}

// ---------------------------------------------------------------- prospects

model Company {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @db.Uuid
  name          String
  domain        String?
  website       String?
  linkedinUrl   String?
  industry      String?
  employeeCount Int?
  country       String?
  city          String?
  description   String?
  services      String[]
  audience      String?
  businessModel String?
  customFields  Json     @default("{}")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads           Lead[]
  researchReports ResearchReport[]
  opportunities   Opportunity[]
  notes           Note[]

  @@unique([workspaceId, domain])
  @@index([workspaceId, name])
}

model LeadSource {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid
  type        LeadSourceType
  name        String
  provider    String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]

  @@unique([workspaceId, name])
}

model Lead {
  id                      String                  @id @default(uuid()) @db.Uuid
  workspaceId             String                  @db.Uuid
  companyId               String?                 @db.Uuid
  sourceId                String?                 @db.Uuid
  ownerId                 String?                 @db.Uuid
  email                   String
  emailNormalized         String
  emailVerificationStatus EmailVerificationStatus @default(UNVERIFIED)
  emailVerifiedAt         DateTime?               @db.Timestamptz(3)
  firstName               String?
  lastName                String?
  title                   String?
  linkedinUrl             String?
  website                 String?
  phone                   String?
  country                 String?
  city                    String?
  timezone                String?
  status                  LeadStatus              @default(NEW)
  lawfulBasis             LawfulBasis             @default(UNKNOWN)
  lawfulBasisNote         String?
  externalId              String?
  customFields            Json                    @default("{}")
  tags                    String[]
  currentScore            Int?
  lastContactedAt         DateTime?               @db.Timestamptz(3)
  lastRepliedAt           DateTime?               @db.Timestamptz(3)
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(3)

  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company         Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  source          LeadSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  owner           User?                @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  statusChanges   LeadStatusChange[]
  verifications   EmailVerification[]
  researchReports ResearchReport[]
  scores          LeadScore[]
  listMembers     LeadListMember[]
  enrollments     SequenceEnrollment[]
  conversations   Conversation[]
  events          EmailEvent[]
  opportunities   Opportunity[]
  notes           Note[]
  tasks           Task[]

  aiInstructions   String?
  personalizations LeadPersonalization[]
  aiWorkflowRuns   AiWorkflowRun[]

  @@unique([workspaceId, emailNormalized])
  @@index([workspaceId, status])
  @@index([workspaceId, companyId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, currentScore])
}

model LeadStatusChange {
  id          String      @id @default(uuid()) @db.Uuid
