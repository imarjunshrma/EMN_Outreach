// ===================================================================== AI Studio & personalization

/// Versioned workspace-level AI configuration: business knowledge, writing rules, research rules.
/// Every save creates a new version; exactly one version per kind is active.
model AiConfigVersion {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  kind        AiConfigKind
  version     Int
  data        Json
  isActive    Boolean      @default(false)
  changeNote  String?
  createdById String?      @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind, version])
  @@index([workspaceId, kind, isActive])
}

/// Supporting documents (text extracted on upload) used as trusted business knowledge.
model KnowledgeDocument {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  title       String
  fileName    String?
  mimeType    String?
  storageKey  String?
  text        String
  charCount   Int
  isActive    Boolean  @default(true)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
}

/// Reusable custom prompt profile (prompt builder). Content lives in immutable versions.
model PromptProfile {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  name            String
  description     String?
  activeVersionId String?  @db.Uuid
  folder          String?
  tags            String[]
  isApproved      Boolean  @default(false)
  approvedById    String?  @db.Uuid
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  PromptProfileVersion[]
  campaigns Campaign[]

  @@unique([workspaceId, name])
}

model PromptProfileVersion {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @db.Uuid
  profileId    String   @db.Uuid
  version      Int
  instructions String // prompt template: {{variables}}, {{#if x}}…{{else}}…{{/if}}, {{#unless x}}…{{/unless}}
  settings     Json     @default("{}") // writing overrides (tone, length, cta…) applied at the profile level
  changeNote   String?
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   PromptProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, version])
}

/// Per-lead, per-step personalized content for a campaign. One current row per (campaign, lead, step);
/// every generation or manual edit is also appended to PersonalizationRevision.
model LeadPersonalization {
  id                  String                @id @default(uuid()) @db.Uuid
  workspaceId         String                @db.Uuid
  campaignId          String                @db.Uuid
  leadId              String                @db.Uuid
  stepId              String                @db.Uuid
  variantId           String?               @db.Uuid
  status              PersonalizationStatus @default(QUEUED)
  subject             String?
  openingLine         String?
  body                String?
  cta                 String?
  subjectAlternatives String[]
  usedClaimIds        String[]
  researchReportIds   String[]
  quality             Json?
  qualityPassed       Boolean               @default(false)
  score               Int?
  scoreExplanation    Json?
  costUsd             Decimal               @default(0) @db.Decimal(12, 6)
  costIsEstimate      Boolean               @default(true)
  manuallyEdited      Boolean               @default(false)
  editedById          String?               @db.Uuid
  editedAt            DateTime?             @db.Timestamptz(3)
  approvedById        String?               @db.Uuid
  approvedAt          DateTime?             @db.Timestamptz(3)
  approvedContentHash String?
  configHash          String?
  profileVersionId    String?               @db.Uuid
  revision            Int                   @default(0)
  batchId             String?               @db.Uuid
  error               String?
  generatedAt         DateTime?             @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)

  workspace Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead      Lead                      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  step      SequenceStep              @relation(fields: [stepId], references: [id], onDelete: Cascade)
  variant   SequenceStepVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  revisions PersonalizationRevision[]
  feedback  OutreachFeedback[]

  @@unique([campaignId, leadId, stepId])
  @@index([workspaceId, campaignId, status])
  @@index([batchId])
}

model PersonalizationRevision {
  id                String         @id @default(uuid()) @db.Uuid
  workspaceId       String         @db.Uuid
  personalizationId String         @db.Uuid
  revision          Int
  source            RevisionSource
  subject           String?
  openingLine       String?
  body              String?
  cta               String?
  usedClaimIds      String[]
  quality           Json?
  score             Int?
  costUsd           Decimal        @default(0) @db.Decimal(12, 6)
  executionIds      String[]
  createdById       String?        @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personalization LeadPersonalization @relation(fields: [personalizationId], references: [id], onDelete: Cascade)

  @@unique([personalizationId, revision])
}

/// Workspace-specific customer instructions, prioritized and versioned by timestamp.
model OutreachRule {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @db.Uuid
  title        String
  description  String
  category     String
  priority     String
  condition    String?
  status       String   @default("ACTIVE")
  triggerTerms String[] @default([])
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, category, priority])
}

/// Text examples are workspace-scoped and retrieved selectively; never ingested as instructions.
model OutreachExample {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @db.Uuid
  name             String
  content          String
  correctedContent String?
  category         String
  polarity         String
  explanation      String?
  tags             String[] @default([])
  isActive         Boolean  @default(true)
  createdById      String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive, category, polarity])
}

/// Audit of human decisions/edits to generated content; snapshots support opt-in pattern analysis.
model OutreachFeedback {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @db.Uuid
  personalizationId String   @db.Uuid
  feedbackType      String
  originalContent   Json
  finalContent      Json
  changedFields     String[] @default([])
  explanation       String?
  scope             String   @default("CAMPAIGN")
  createdById       String?  @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personalization LeadPersonalization @relation(fields: [personalizationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, feedbackType, createdAt])
  @@index([workspaceId, personalizationId])
}

/// Customer-reviewed learning proposal. Suggestions never silently change active rules.
model AiLearningSuggestion {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  signature   String
  title       String
  description String
  category    String
  confidence  Float
  sampleCount Int
  evidence    Json     @default("[]")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, signature])
  @@index([workspaceId, status, createdAt])
}

/// Bulk generation run (estimate → confirm → queued per lead/step).
model PersonalizationBatch {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  campaignId       String    @db.Uuid
  status           JobStatus @default(PENDING)
  total            Int       @default(0)
  done             Int       @default(0)
  failed           Int       @default(0)
  skipped          Int       @default(0)
  estimatedCostUsd Decimal   @default(0) @db.Decimal(12, 6)
  maxCostUsd       Decimal?  @db.Decimal(12, 4)
  spentUsd         Decimal   @default(0) @db.Decimal(12, 6)
  options          Json      @default("{}")
  error            String?
  createdById      String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  completedAt      DateTime? @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([workspaceId, campaignId])
}

/// Immutable snapshot of a campaign's sequence + AI configuration, taken at every approval.
model SequenceVersion {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @db.Uuid
  campaignId   String   @db.Uuid
  version      Int
  snapshot     Json
  contentHash  String
  approvedById String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, version])
}

// ===================================================================== v1.2 security, AI reply, copilot, workflows, billing, CRM

/// Single-use password-reset tokens (only the SHA-256 hash is stored). Not workspace data, but linked
/// to the workspace that sent the email for audit purposes when known.
model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  workspaceId String?   @db.Uuid
  kind        String    @default("RESET") // RESET | MFA_CHALLENGE
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)
  ip          String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, kind])
}

/// Human-approved reply templates. The only content the narrow auto-reply mode may send.
model ReplyTemplate {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @db.Uuid
  name         String
  body         String
  categories   String[]
  isApproved   Boolean   @default(false)
  approvedById String?   @db.Uuid
  approvedAt   DateTime? @db.Timestamptz(3)
  createdById  String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

/// AI reply suggestions / drafts awaiting approval / auto-replies (audit of what was sent and why).
model ReplySuggestion {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @db.Uuid
  conversationId String           @db.Uuid
  messageId      String           @db.Uuid
  mode           String // SUGGEST | DRAFT | AUTO
  category       String?
  body           String
  templateId     String?          @db.Uuid
  status         SuggestionStatus @default(PENDING)
  reason         String?
  decidedById    String?          @db.Uuid
  decidedAt      DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([messageId, mode])
  @@index([workspaceId, status])
}

model CopilotThread {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  title       String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  CopilotMessage[]
  actions   CopilotAction[]

  @@index([workspaceId, userId])
}

model CopilotMessage {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  threadId    String   @db.Uuid
  role        String // USER | ASSISTANT
  content     String
  data        Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  thread    CopilotThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// Actions the Copilot PROPOSED. Nothing runs until a user with the required role confirms it.
model CopilotAction {
  id           String              @id @default(uuid()) @db.Uuid
  workspaceId  String              @db.Uuid
  threadId     String              @db.Uuid
  type         String
  params       Json
  summary      String
  requiredRole String
  status       CopilotActionStatus @default(PROPOSED)
  result       Json?
  executedById String?             @db.Uuid
  executedAt   DateTime?           @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  thread    CopilotThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

/// Business memory: reusable facts/instructions the Copilot always receives.
model CopilotMemory {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  content     String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Visual workflows (graph of trigger → condition/branch → action nodes), versioned.
model Workflow {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  name            String
  trigger         String
  isActive        Boolean  @default(false)
  activeVersionId String?  @db.Uuid
  maxRunsPerDay   Int      @default(1000)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  WorkflowVersion[]
  runs      WorkflowRun[]

  @@unique([workspaceId, name])
  @@index([workspaceId, trigger, isActive])
}

model WorkflowVersion {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  workflowId  String   @db.Uuid
  version     Int
  graph       Json
  changeNote  String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
}

model WorkflowRun {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workflowId  String    @db.Uuid
  versionId   String    @db.Uuid
  dedupeKey   String?
  event       Json
  status      JobStatus @default(RUNNING)
  testMode    Boolean   @default(false)
  log         Json      @default("[]")
  error       String?
  attempts    Int       @default(1)
  startedAt   DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt  DateTime? @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, dedupeKey])
  @@index([workspaceId, startedAt])
}

/// Subscription plans; entitlements are data, never hard-coded in the UI.
model Plan {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique
  name              String
  description       String    @default("")
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)
  archivedAt        DateTime? @db.Timestamptz(3)
  priceMonthlyCents Int
  priceYearlyCents  Int
  currency          String    @default("USD")
  entitlements      Json
  trialDays         Int       @default(14)
  isPublic          Boolean   @default(true)
  providerPriceIds  Json      @default("{}")
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  // Billing is per organization (tenant). workspaceId is kept only for subscriptions created before 1.3.
  organizationId         String             @unique @db.Uuid
  workspaceId            String?            @unique @db.Uuid
  planId                 String             @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  interval               String             @default("month")
  provider               String             @default("manual")
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  currentPeriodEnd       DateTime?          @db.Timestamptz(3)
  currentPeriodStart     DateTime?          @db.Timestamptz(3)
  /// Provider timestamp of the newest event applied; older events never overwrite newer state (out-of-order delivery).
  lastEventAt            DateTime?          @db.Timestamptz(3)
  trialEndsAt            DateTime?          @db.Timestamptz(3)
  graceUntil             DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false)
  overrides              Json               @default("{}")
  scheduledPlanId        String?            @db.Uuid
  canceledAt             DateTime?          @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  plan         Plan         @relation(fields: [planId], references: [id])
}

model Invoice {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @db.Uuid
  workspaceId         String?   @db.Uuid
  provider            String
  providerInvoiceId   String?   @unique
  /// Stripe charge / payment_intent or Razorpay payment id — needed to refund.
  providerPaymentId   String?
  amountCents         Int
  amountRefundedCents Int       @default(0)
  currency            String
  status              String
  hostedUrl           String?
  periodStart         DateTime? @db.Timestamptz(3)
  periodEnd           DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)

  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

/// Processed payment-provider webhook events (idempotency).
model BillingEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, eventId])
}

model SavedFilter {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  entity      String
  name        String
  query       Json
  isShared    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entity])
}

model ScheduledReport {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  name        String
  kind        String // campaign_summary | pipeline | ai_cost
  frequency   String // DAILY | WEEKLY
  recipients  String[]
  isActive    Boolean   @default(true)
  lastSentAt  DateTime? @db.Timestamptz(3)
  lastError   String?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// External notification destinations (Slack incoming webhook, email).
model NotificationChannel {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  type            String // SLACK | EMAIL
  name            String
  encryptedConfig String
  events          String[]
  isActive        Boolean  @default(true)
  lastError       String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ============================================================== SaaS tenancy (1.3)

enum OrgStatus {
  PENDING_SETUP
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  DELETION_PENDING
  DELETED
}

enum OrgRole {
  OWNER
  ADMIN
  BILLING
  MEMBER
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  FINANCE
}

/// A tenant: one independent customer organization. Owns workspaces, subscription, usage and billing.
model Organization {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String    @unique
  status               OrgStatus @default(PENDING_SETUP)
  ownerId              String?   @db.Uuid
  billingOwnerId       String?   @db.Uuid
  timezone             String    @default("UTC")
  locale               String    @default("en")
  currency             String    @default("USD")
  branding             Json      @default("{}")
  settings             Json      @default("{}")
  onboarding           Json      @default("{}")
  statusReason         String?
  statusChangedAt      DateTime? @db.Timestamptz(3)
  deletionRequestedAt  DateTime? @db.Timestamptz(3)
  deletionScheduledFor DateTime? @db.Timestamptz(3)
  deletedAt            DateTime? @db.Timestamptz(3)
  /// Idempotency key of the registration request that created this tenant (repeat requests return the same tenant).
  registrationKey      String?   @unique
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  members       OrganizationMember[]
  workspaces    Workspace[]
  subscription  Subscription?
  invoices      Invoice[]
  usageCounters UsageCounter[]
  usageEvents   UsageEvent[]
  supportGrants SupportAccessGrant[]
  statusHistory OrganizationStatusChange[]
  refunds       Refund[]
  disputes      BillingDispute[]
  storedObjects StoredObject[]

  @@index([status])
}

model OrganizationMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           OrgRole
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationStatusChange {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  fromStatus     OrgStatus?
  toStatus       OrgStatus
  reason         String?
  actorUserId    String?    @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

/// Running total per tenant, metric and billing period. Updated atomically from UsageEvent.
model UsageCounter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  metric         String
  periodStart    DateTime @db.Timestamptz(3)
  periodEnd      DateTime @db.Timestamptz(3)
  value          BigInt   @default(0)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, periodStart])
}

/// One metered event. (organizationId, idempotencyKey) is unique, so a retried request is never counted twice.
model UsageEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String?  @db.Uuid
  metric         String
  quantity       BigInt
  idempotencyKey String
  occurredAt     DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, metric, occurredAt])
}

/// Time-limited, reason-stated access by platform support staff to one tenant. Every use is audited.
model SupportAccessGrant {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  adminUserId    String    @db.Uuid
  reason         String
  scope          String    @default("read")
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
}

/// Platform-level audit trail (append-only, DB-enforced): admin actions, tenant lifecycle, support access.
model PlatformAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  organizationId String?  @db.Uuid
  targetType     String?
  targetId       String?
  reason         String?
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
}

/// A refund requested by platform staff or reported by the payment provider. Never executed against
/// a live provider from development; provider confirmation arrives by verified webhook.
model Refund {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  invoiceId         String?  @db.Uuid
  provider          String
  providerRefundId  String?  @unique
  providerPaymentId String?
  amountCents       Int
  currency          String
  status            String   @default("pending") // pending | succeeded | failed | canceled
  reason            String?
  requestedById     String?  @db.Uuid
  idempotencyKey    String   @unique
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

/// Chargebacks / payment disputes reported by the provider.
model BillingDispute {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  provider          String
  providerDisputeId String   @unique
  providerPaymentId String?
  amountCents       Int
  currency          String
  status            String // open | won | lost | closed
  reason            String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// One free trial per person: keyed by a hash of the normalised email (dots/plus-tags removed for
/// Gmail-style providers). Survives organization deletion so a trial cannot be re-obtained by deleting
/// and re-registering. Stores no readable email.
model TrialGrant {
  id             String   @id @default(uuid()) @db.Uuid
  identityHash   String   @unique
  organizationId String?  @db.Uuid
  planCode       String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
}

/// Every object the application stores for a customer, with its real size, for storage accounting.
model StoredObject {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  key            String   @unique
  kind           String
  bytes          BigInt
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workspaceId])
}

// ---------------------------------------------------------------- personal AI subscriptions (owner-only)
// Claude (Agent SDK + CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`) and Codex (ChatGPT sign-in via
// `codex login --device-auth`). Visible only to the accounts listed in AI_SUBSCRIPTION_OWNER_EMAILS.

enum AiSubscriptionProvider {
  CLAUDE_SUBSCRIPTION
  CODEX_SUBSCRIPTION
}

enum AiSubscriptionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  EXPIRED
  USAGE_LIMITED
  ERROR
}

model AiSubscriptionConnection {
  id                  String                 @id @default(uuid()) @db.Uuid
  ownerUserId         String                 @db.Uuid
  provider            AiSubscriptionProvider
  status              AiSubscriptionStatus   @default(DISCONNECTED)
  /// Claude only: CLAUDE_CODE_OAUTH_TOKEN encrypted with AI_SUBSCRIPTION_ENCRYPTION_KEY. Codex keeps its own auth.json under CODEX_HOME.
  encryptedCredential String?
  credentialHint      String?
  accountLabel        String?
  model               String?
  concurrency         Int                    @default(1)
  delayMs             Int                    @default(3000)
  paused              Boolean                @default(false)
  connectedAt         DateTime?              @db.Timestamptz(3)
  expiresAt           DateTime?              @db.Timestamptz(3)
  lastTestedAt        DateTime?              @db.Timestamptz(3)
  lastTestOk          Boolean?
  lastError           String?
  limitResetsAt       DateTime?              @db.Timestamptz(3)
  limitType           String?
  utilization         Float?
  lastUsedAt          DateTime?              @db.Timestamptz(3)
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, provider])
}

model AiWorkflow {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @db.Uuid
  name        String
  description String?
  presetKey   String?
  isDefault   Boolean  @default(false)
  stages      Json     @default("[]")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  owner User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  runs  AiWorkflowRun[]

  @@unique([ownerUserId, presetKey])
  @@index([ownerUserId])
}

model AiStageTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @db.Uuid
  name        String
  stage       Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
}

model AiPlaybookVersion {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @db.Uuid
  version     Int
  content     String
  note        String?
  isCurrent   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  owner User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  runs  AiWorkflowRun[]

  @@unique([ownerUserId, version])
}

enum AiWorkflowRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  PAUSED
  PAUSED_LIMIT
  CANCELLED
}

model AiWorkflowRun {
  id                String              @id @default(uuid()) @db.Uuid
  ownerUserId       String              @db.Uuid
  workspaceId       String              @db.Uuid
  leadId            String              @db.Uuid
  campaignId        String?             @db.Uuid
  workflowId        String?             @db.Uuid
  workflowName      String
  workflowSnapshot  Json
  playbookVersionId String?             @db.Uuid
  status            AiWorkflowRunStatus @default(QUEUED)
  currentStage      Int                 @default(0)
  stageOutputs      Json                @default("{}")
  research          Json?
  variants          Json                @default("[]")
  selectedVariant   Int?
  draft             Json?
  draftSavedAt      DateTime?           @db.Timestamptz(3)
  pausedReason      String?
  pausedProvider    String?
  autoResume        Boolean             @default(false)
  /// One-time token of the stage job that may run next; claimed atomically so a stage never runs twice.
  jobToken          String?
  error             String?
  startedAt         DateTime?           @db.Timestamptz(3)
  finishedAt        DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  owner      User                       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  workspace  Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead       Lead                       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign   Campaign?                  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  workflow   AiWorkflow?                @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  playbook   AiPlaybookVersion?         @relation(fields: [playbookVersionId], references: [id], onDelete: SetNull)
  executions AiWorkflowStageExecution[]

  @@index([workspaceId, leadId])
  @@index([ownerUserId, status])
}

model AiWorkflowStageExecution {
  id           String    @id @default(uuid()) @db.Uuid
  runId        String    @db.Uuid
  workspaceId  String    @db.Uuid
  stageIndex   Int
  stageId      String
  stageName    String
  taskType     String
  provider     String
  model        String?
  status       String
  attempt      Int       @default(1)
  durationMs   Int?
  errorMessage String?
  inputTokens  Int?
  outputTokens Int?
  startedAt    DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime? @db.Timestamptz(3)

  run AiWorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([workspaceId, startedAt])
}

/// Platform-wide settings edited by super admins (sign-up mode, announcement banner). One row per key.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}
