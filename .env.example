# ---------------------------------------------------------------------------
# EMN Outreach OS — environment configuration (copy to .env, chmod 600)
# Generate secrets with:  npm run gen-keys
# ---------------------------------------------------------------------------
NODE_ENV=production
# Public HTTPS origin of the app (used for OAuth redirects, unsubscribe links, webhooks)
APP_URL=https://outreach.example.com
API_PORT=4000
TRUST_PROXY=true
LOG_LEVEL=info

# PostgreSQL (runtime role) and owner role for migrations
DATABASE_URL=postgresql://emn_app:CHANGE_ME@127.0.0.1:5432/emn
DATABASE_MIGRATION_URL=postgresql://emn_owner:CHANGE_ME@127.0.0.1:5432/emn
DB_POOL_MAX=10

# Redis (password protected, bound to localhost)
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
QUEUE_PREFIX=emn

# Secrets (never commit real values)
SESSION_SECRET=CHANGE_ME_min_32_chars_random
ENCRYPTION_KEYS=1:CHANGE_ME_base64_32_bytes
ENCRYPTION_ACTIVE_KEY=1

# Local file storage (imports, attachments, exports)
STORAGE_ROOT=/var/lib/emn/storage
# Optional S3-compatible object storage instead of local disk (AWS S3, Cloudflare R2, Backblaze B2, MinIO…)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=

# Allow anyone to register (keep false for a single-owner install; use invitations)
PUBLIC_REGISTRATION=false

# Google Workspace (Gmail API) OAuth client — Google Cloud Console → Credentials → OAuth client (Web)
# Authorized redirect URI: ${APP_URL}/api/v1/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365 (Graph) — Entra ID app registration (multi-tenant)
# Redirect URI (Web): ${APP_URL}/api/v1/oauth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Push notifications for Microsoft mailboxes (requires public HTTPS APP_URL). Polling always runs as a backstop.
GRAPH_WEBHOOKS_ENABLED=false

# Worker
WORKER_CONCURRENCY_SEND=4

# NOTE: AI keys (OpenAI / Anthropic) and data-provider keys (Apollo, MillionVerifier, Brave, Serper,
# Smartlead) are NOT set here. Add them in the app (AI Settings / Integrations); they are stored encrypted.

# ---------------------------------------------------------------- v1.2
# System email (password reset links, 2FA notices, scheduled reports, email alert channels).
# A transactional SMTP account (Postmark, SES, Mailgun, Brevo… or your own server). NEVER a prospecting mailbox.
# Format: smtps://user:pass@smtp.example.com:465  or  smtp://user:pass@smtp.example.com:587
SYSTEM_SMTP_URL=
SYSTEM_MAIL_FROM="EMN Outreach OS <no-reply@yourdomain.com>"

# SaaS billing. Keep false for a single-company self-hosted install (no plans, no limits).
BILLING_ENABLED=false
# Stripe (global): Dashboard → Developers → API keys; webhook endpoint ${APP_URL}/api/v1/webhooks/billing/stripe
# events: checkout.session.completed, customer.subscription.created|updated|deleted, invoice.paid, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Razorpay (India): Settings → API keys; webhook ${APP_URL}/api/v1/webhooks/billing/razorpay
# events: subscription.activated, subscription.charged, subscription.halted, subscription.pending, subscription.cancelled, subscription.completed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan price IDs are stored per plan in the database (Plan.providerPriceIds, e.g. {"stripe_month":"price_…",
# "stripe_year":"price_…","razorpay_month":"plan_…"}) — see docs/18-v1.2-operations.md.

# Verifier / finder / DNS keys (ZeroBounce, NeverBounce, Hunter, Cloudflare) are added in the app under Integrations.
# Live provider checks (npm run live-check) read LIVE_* variables — put them in a separate, untracked file.

# ---------------------------------------------------------------- v1.3 multi-tenant SaaS
# Self-service sign-up: true / false. Empty = open when BILLING_ENABLED=true, invite-only otherwise.
REGISTRATION_OPEN=
# Require a verified email before inviting teammates or starting campaigns (always on when BILLING_ENABLED=true).
REQUIRE_EMAIL_VERIFICATION=false
# Days a PAST_DUE tenant keeps working before it is suspended.
BILLING_GRACE_DAYS=7
# Days between "delete my organization" and permanent erasure (the owner can cancel during this time).
TENANT_DELETION_GRACE_DAYS=14
# Max concurrent AI / research / personalization / verification / import jobs per organization (fair share).
TENANT_JOB_SLOTS=2
